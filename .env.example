# Local development only. Matches docker-compose.yml (throwaway demo credentials).
DATABASE_URL=postgres://boundary:boundary_dev_only@localhost:5440/boundary

# Optional: cookie Secure flag override. Default: on when NODE_ENV=production.
# COOKIE_SECURE=0

# Optional: trust X-Forwarded-For for login throttling (only behind a proxy you control).
# TRUST_PROXY_HEADERS=1

# Test runner target (default http://localhost:3000)
# BOUNDARY_BASE_URL=http://localhost:3000

# UNSAFE DEMO MODE: do NOT set these here. Use `npm run dev:unsafe`, which sets
# them only for that one dev-server process. See README "Vulnerability demo".
